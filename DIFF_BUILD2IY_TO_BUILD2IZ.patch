   //   DAUX $7002 = payload recordu (DBYT=len, DBUF=dst) - zadny buffer,
   //   zadna kolize s hrami nahravajicimi na $0700+.
   const XEX_LOADER_B64="";
+  function annotateXexVbxeMemacPreload(recs){
+    // BUILD2IZ: obecna oprava XEX loaderu pro VBXE MEMAC bank-load bloky.
+    // Vzor pouziva Mad Pascal/Tebe VBXE unit i dalsi FX programy: XEX nahraje 7B rutinu
+    //   A9 bank / A0 5F / 91 80 / 60
+    // a pak pres INITAD zavola zapis hodnoty bank do ($80),Y = $D65F. Nasledujici data
+    // na $B000-$BFFF maji jit do legacy MEMAC-A okna, tedy do VBXE VRAM, ne zustat jen v Atari RAM.
+    const setters={};
+    let activeA=-1, segments=0, bytes=0, firstBank=-1, lastBank=-1;
+    for(let i=0;i<recs.length;i++){
+      const r=recs[i];
+      const pay=r.pay||new Uint8Array(0);
+      if(r.len>=7 && pay[0]===0xA9 && pay[2]===0xA0 && pay[3]===0x5F && pay[4]===0x91 && pay[5]===0x80 && pay[6]===0x60){
+        setters[r.dst&0xFFFF]=pay[1]&0xFF;
+        r.vbxeMemacASetter=pay[1]&0xFF;
+      }
+      if(r.len>=2 && r.dst<=0x02E2 && ((r.dst+r.len-1)&0xFFFF)>=0x02E3){
+        const o=(0x02E2-r.dst)|0;
+        if(o>=0 && o+1<pay.length){
+          const init=(pay[o]|(pay[o+1]<<8))&0xFFFF;
+          if(Object.prototype.hasOwnProperty.call(setters,init)){
+            activeA=setters[init]&0xFF;
+            if(firstBank<0) firstBank=activeA;
+            lastBank=activeA;
+          }
+        }
+      }
+      if(activeA>=0 && (activeA&0x80) && r.len>0){
+        const rs=r.dst&0xFFFF, re=(r.dst+r.len-1)&0xFFFF;
+        if(rs<=0xBFFF && re>=0xB000){
+          const st=Math.max(rs,0xB000), en=Math.min(re,0xBFFF);
+          const off=(st-rs)|0, ln=(en-st+1)|0;
+          const vram=(((activeA&0x7F)<<12) + (st-0xB000)) & 0x7FFFF;
+          r.vbxePreload={off:off,len:ln,vram:vram,bank:activeA&0xFF};
+          segments++; bytes+=ln; lastBank=activeA&0xFF;
+        }
+      }
+    }
+    return {segments:segments,bytes:bytes,firstBank:firstBank,lastBank:lastBank};
+  }
+
+  function applyXexVbxePreloadRecord(X,r){
+    // BUILD2IZ: vykona doplnkovy MEMAC write ve stejnem okamziku, kdy rychly loader servíruje payload.
+    // CPU/OS porad dostane normalni payload; jen opravujeme vedlejsi efekt MEMAC okna, ktery realny init-loader vyvolal.
+    if(!r || !r.vbxePreload || r.vbxePreloadDone || !vbxe || !vbxe.vram) return;
+    const m=r.vbxePreload, pay=r.pay||new Uint8Array(0);
+    const lim=Math.min(m.len|0, Math.max(0,pay.length-(m.off|0)));
+    if(lim<=0) return;
+    for(let k=0;k<lim;k++) vbxe.vram[(m.vram+k)&0x7FFFF]=pay[(m.off|0)+k]&0xFF;
+    r.vbxePreloadDone=true;
+    vbxe.renderDirty=true;
+    vbxe.renderBase=m.vram&0x7C000;
+    if(X){ X.vbxePreloadDone=(X.vbxePreloadDone||0)+1; X.vbxePreloadBytes=(X.vbxePreloadBytes||0)+lim; }
+    if(M.vbxeDebug && (!X || (X.vbxePreloadLog||0)<12)){
+      if(X) X.vbxePreloadLog=(X.vbxePreloadLog||0)+1;
+      M.vbxeDebug('VBXE XEX MEMAC PRELOAD BUILD2IZ: $B000 payload -> VRAM $'+(m.vram&0x7FFFF).toString(16).toUpperCase().padStart(5,'0')+' len='+lim+' bank=$'+hx2(m.bank)+'; obecny INITAD/MEMAC loader, ne herni hack.');
+    }
+  }
