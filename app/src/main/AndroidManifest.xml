<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- BUILD2SB6: hapticka odezva na stisk PS1 tlacitek (profi ovladac, ne jen viditelny ctverecek) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BUILD2SA42: aktualizace primo ze site (PackageInstaller) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="AtariHelp TEST"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.NoTitleBar">

        <activity
            android:name="eu.atarihelp.emu10.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- KROK C: renderer PS1 jako samostatna nativni aktivita.
             Obraz jde z jadra rovnou na displej (eglrender + core_ps1,
             zadna Java v obrazove ceste). Po vyskoceni se vrati menu. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="PS1"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|keyboard"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="eglrender" />
        </activity>

    </application>
</manifest>
