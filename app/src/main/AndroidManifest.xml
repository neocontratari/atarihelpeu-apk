<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- B303: Wi-Fi v rezimu nizke latence behem prenosu na TV / PC (WifiLock potrebuje WAKE_LOCK;
         bezne opravneni, uzivatel nic nepotvrzuje) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- BUILD2SB6: hapticka odezva na stisk PS1 tlacitek (profi ovladac, ne jen viditelny ctverecek) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BUILD2SA42: aktualizace primo ze site (PackageInstaller) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- B331: Bluetooth ovladac primo v appce (OPTIONS -> HERNI OVLADAC -> PRIPOJIT OVLADAC).
         Android 12+: "Zarizeni v okoli" (hledani BEZ polohy - neverForLocation) + pripojeni.
         Android 6-11: hledani Bluetooth Android povoli jen s povolenim k poloze (appka polohu nezjistuje). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- B334: ANDROID TV (Rene: "nainstalovat primo do televize, ikona v nabidce televize, ovladat
         ovladacem od TV nebo gamepadem"). Appka TV umi (leanback), ale neni jen pro ni; dotykovy displej
         ani poloha (jen kvuli hledani Bluetooth na Androidu 6-11) nejsou podminkou instalace. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- B313: allowBackup=false - Android appce po nove instalaci vracel nastaveni ze zalohy
         v Google uctu (Auto Backup), i odemcenou Segu a PS1 (Rene: "i pred zadanim kodu je
         aplikace odemcena", appku vzdy maze a instaluje znovu). Navod rika, ze postup se
         odinstalovanim smaze - ted to plati. -->
    <!-- B332: nazev appky pod ikonou (Rene: "prepis uz nazev aplikace z AtariHelp TEST na (C)N&P Vision").
         Balicek (eu.atarihelp.emu10.test) zustava - jinak by se aktualizace nenainstalovala pres starou appku. -->
    <application
        android:allowBackup="false"
        android:label="©N&amp;P Vision"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/nap_tv_banner"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.NoTitleBar">

        <!-- B320: herni ovladac (Retroid Pocket 6, Bluetooth / USB gamepad) - pripojeni nebo odpojeni
             ovladace meni konfiguraci (keyboard, navigation), Retroid i velikost / rezim displeje.
             Bez tohohle by Android aktivitu zrusil a vytvoril znovu = rozehrana hra by skoncila. -->
        <activity
            android:name="eu.atarihelp.emu10.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|keyboard|navigation|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- B334: ikona (banner) v nabidce Android TV -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- KROK C: renderer PS1 jako samostatna nativni aktivita.
             Obraz jde z jadra rovnou na displej (eglrender + core_ps1,
             zadna Java v obrazove ceste). Po vyskoceni se vrati menu. -->
        <activity
            android:name="android.app.NativeActivity"
            android:label="PS1"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|keyboard"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="eglrender" />
        </activity>

        <!-- B327: po vlastni aktualizaci appku zase otevrit (Android 9 a starsi). Od Androidu 10 system
             spousteni z pozadi nedovoli - tam ji clovek otevre ikonou a appka pri startu ukaze
             "Nainstalovana nova verze". MY_PACKAGE_REPLACED posila jen system (chranena zprava). -->
        <receiver
            android:name="eu.atarihelp.emu10.NapPoAktualizaci"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
