+  function vbxePreloadRangeForCpuAddr(a){
+    // BUILD2JA: zive mapovani podle aktualniho MEMAC stavu tesne pred servirovanim XEX payloadu.
+    // Tim se neodhadují banky podle jmena hry; pouziva se stejna cesta jako cpuWrite()/cpuRead().
+    a&=0xFFFF;
