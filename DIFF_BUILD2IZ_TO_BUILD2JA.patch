+  function applyXexVbxeLiveMemacPayload(X,r){
+    // BUILD2JA: obecny doplnkovy side-effect pro XEX turbo loader.
+    // Normalni OS/loader porad dostane payload pres SIO; tady pouze dorovnavam stav VBXE VRAM,
+    // ktery by vznikl, kdyby SIO zapisovalo do CPU adresy s prave aktivnim MEMAC oknem.
+    if(!r || r.vbxeLiveMemacDone || !vbxe || !vbxe.vram || !r.pay || !r.len) return 0;
+    const pay=r.pay, base=r.dst&0xFFFF;
+    let copied=0, firstCpu=-1, firstVram=-1, lastCpu=-1, segs=0;
+    let runCpu=-1, runVram=-1, runLen=0;
+    function flush(){
+      if(runLen<=0) return;
+      segs++;
+      if(M.vbxeDebug && X && (X.vbxeLiveMemacLog||0)<12){
+        X.vbxeLiveMemacLog=(X.vbxeLiveMemacLog||0)+1;
+        M.vbxeDebug('VBXE XEX LIVE MEMAC BUILD2JA: CPU $'+hx4(runCpu)+'-$'+hx4((runCpu+runLen-1)&0xFFFF)+' -> VRAM $'+runVram.toString(16).toUpperCase().padStart(5,'0')+' len='+runLen+'; podle aktualnich MEMAC registru, ne podle hry.');
+      }
+      runLen=0; runCpu=-1; runVram=-1;
+    }
+    for(let k=0;k<pay.length;k++){
+      const ca=(base+k)&0xFFFF;
+      const va=vbxePreloadRangeForCpuAddr(ca);
+      if(va<0){ flush(); continue; }
+      vbxe.vram[va]=pay[k]&0xFF;
+      copied++;
+      if(firstCpu<0){ firstCpu=ca; firstVram=va; }
+      lastCpu=ca;
+      if(runLen>0 && ((runCpu+runLen)&0xFFFF)===ca && ((runVram+runLen)&0x7FFFF)===va){ runLen++; }
+      else { flush(); runCpu=ca; runVram=va; runLen=1; }
+    }
+    flush();
+    if(copied>0){
+      r.vbxeLiveMemacDone=true;
+      vbxe.renderDirty=true;
+      vbxe.renderBase=firstVram&0x7C000;
+      if(X){
+        X.vbxeLiveMemacDone=(X.vbxeLiveMemacDone||0)+1;
+        X.vbxeLiveMemacBytes=(X.vbxeLiveMemacBytes||0)+copied;
+        X.vbxeLiveMemacSegments=(X.vbxeLiveMemacSegments||0)+segs;
+      }
+    }
+    return copied;
+  }
