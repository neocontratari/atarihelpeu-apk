+  function vbxeRenderSurfaceFallback(reason){
+    // BUILD2IY: fallback jen z realne VBXE VRAM, zadny obrazek podle nazvu hry.
+    if(!vbxe.surfaceValid) return 0;
+    var w=vbxe.surfaceWidth|0, h=vbxe.surfaceHeight|0, step=vbxe.surfaceStep|0;
+    if(w<64 || h<32 || step<=0) return 0;
+    // Vyber viditelne sirky podle realneho blitu. 320 je nejbeznejsi Mad Pascal/VGAMed.
+    var drawW = (w>=600 ? 640 : (w>=330 ? 336 : (w>=300 ? 320 : (w>=250 ? 256 : w))));
+    var srcW = Math.min(w, drawW);
+    var fb=M.fb, drew=0, palNo=(vbxe.surfacePal||1)&3;
+    var x0=(384-Math.min(drawW,384))>>1; if(x0<0) x0=0;
+    var base=vbxe.surfaceAddr&0x7FFFF;
+    var lines=Math.min(240,h);
+    for(var yy=0; yy<lines; yy++){
+      var src=(base + yy*step)&0x7FFFF;
+      var gy=yy;
+      if(drawW>=384){
+        for(var x=0;x<384;x++){
+          var sx=(x*srcW/drawW)|0;
+          var v=vbxeVramRead((src+sx)&0x7FFFF)&0xFF;
+          if(!vbxeTransparent8(v)){ fb[gy*384+x]=vbxeColor(v,palNo); drew++; }
+        }
+      } else {
+        for(var x2=0;x2<Math.min(drawW,384);x2++){
+          var sx2=(x2*srcW/drawW)|0;
+          var v2=vbxeVramRead((src+sx2)&0x7FFFF)&0xFF;
+          var px=x0+x2;
+          if(px>=0 && px<384 && !vbxeTransparent8(v2)){ fb[gy*384+px]=vbxeColor(v2,palNo); drew++; }
+        }
+      }
+    }
+    if(drew>0 && !vbxe.surfaceFallbackLogged && M.vbxeDebug){
+      vbxe.surfaceFallbackLogged=true;
+      M.vbxeDebug('VBXE SURFACE FALLBACK BUILD2IY: reason='+reason+' addr=$'+base.toString(16).toUpperCase().padStart(5,'0')+' w='+w+' h='+h+' step='+step+' pal='+palNo+' pixels='+drew+'; kreslim realnou VBXE VRAM, ne hack podle hry.');
+    }
+    return drew;
+  }
