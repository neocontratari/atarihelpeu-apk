+  function vbxeRememberSurfaceCandidate(dst,w,h,dstStep,constant,src,mode){
+    // BUILD2IY: presny opak predchoziho hadani. Tady si pouze pamatuji skutecny velky blit do VBXE VRAM.
+    // Pouziti: kdyz XDL parser vidi jen OFF/neplatny seznam, ale program realne vykreslil surface do VRAM,
+    // smi se jako fallback zobrazit prave tato plocha. Typicky Mad Pascal/Tebe VBXE unit: BMP -> vram+88*320.
+    w|=0; h|=0; dst&=0x7FFFF; dstStep=(dstStep|0)||320;
+    var area=w*h;
+    if(area<8192 || w<64 || h<32) return;
+    if(w>1024 || h>1024) return;
+    // Konstantni velke clear/fill si nechavam jen slabsi; realny copy ma prednost.
+    var score=area + (constant?0:1000000) + (mode===0?10000:0);
+    if(score < (vbxe.surfaceScore||0) && !constant) return;
+    vbxe.surfaceValid=true;
+    vbxe.surfaceAddr=dst;
+    vbxe.surfaceStep=Math.abs(dstStep)||320;
+    vbxe.surfaceWidth=w;
+    vbxe.surfaceHeight=Math.min(240,h);
+    vbxe.surfacePal=(vbxe.regs[0x45]&3) || 1;
+    vbxe.surfaceMode=1; // byte-per-pixel/SR fallback; HR/TEXT XDL ma vlastni render a sem nespadne
+    vbxe.surfaceScore=score;
+    if(!vbxe.surfaceLogged && M.vbxeDebug){
+      vbxe.surfaceLogged=true;
+      M.vbxeDebug('VBXE SURFACE CANDIDATE BUILD2IY: realny blit dst=$'+dst.toString(16).toUpperCase().padStart(5,'0')+' w='+w+' h='+h+' step='+vbxe.surfaceStep+' const='+(constant?1:0)+' src=$'+(src&0x7FFFF).toString(16).toUpperCase().padStart(5,'0'));
+    }
+  }
